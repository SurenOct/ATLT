<Window x:Class="CMATCTUI.ChildWindows.EmailFormat"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CMATCTUI.ChildWindows"
          xmlns:vm="clr-namespace:CMATCTUI.ViewModels"
        mc:Ignorable="d"
        Title="EmailFormat" Height="450" Width="800">
     
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="500"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Email Format"
            FontSize="24"
            FontWeight="Bold" />
            <StackPanel Orientation="Vertical" Margin="0 10 0 10">
                <TextBlock Text="Please Provide Additional Information for request:" FontWeight="Bold" VerticalAlignment="Center" Margin="10 0 5 0"/>
                <TextBlock  Text="Incident Type:"  VerticalAlignment="Center" Margin="10 20 5 0"/>
                <ComboBox  Margin="10 20 0 0" Width="400px" HorizontalAlignment="Left">
                    <ComboBoxItem Content="All" IsSelected="True" />
                    <ComboBoxItem Content="Critical" />
                    <ComboBoxItem Content="Warning" />
                    <ComboBoxItem Content="Info" />
                </ComboBox>

                <TextBlock Text="Incident Description:" FontWeight="Bold" VerticalAlignment="Center" Margin="10 30 5 0"/>
                <TextBox Width="500" Margin="10 0 50 0" HorizontalAlignment="Left" Height="50" Text="{Binding IncidentDescription}"
              ToolTip="Please Provide Brief Description" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" />

                <StackPanel Orientation="Horizontal">
                <StackPanel Orientation="Vertical" Margin="10 20 0 0">
                    <TextBlock Text="Attach File:" FontWeight="Bold" VerticalAlignment="Center" Margin="10 0 0 0"/>
                    <!--<TextBlock Text="Attach File:" FontWeight="Bold" VerticalAlignment="Center" Margin="10 0 0 0"/>-->
                    <Button Content="Attach File" Width="80" Height="30" Margin="0 10 0 0" HorizontalAlignment="Left" Click="Button_Click"/>
                </StackPanel>
                    <Button Content="Send Email"  Width="80" Command="{Binding SendEmailCommand}" Height="30" Margin="200 40 0 0" HorizontalAlignment="Right"/>
                </StackPanel>


                <!--<Button Content="Create Ticket" Click="Button_Click" Margin="20,0,0,0" Width="80" />-->
            </StackPanel>
        </StackPanel>

    </Grid>
</Window>
