<Page x:Class="CMATCTUI.Pages.AboutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:CMATCTUI.Pages"
      mc:Ignorable="d" 
        Width="850"
        Height="650"
         
      Title="AboutPage" Background="White">

    <Grid Margin="20">
        <ScrollViewer VerticalScrollBarVisibility="Auto">

            <StackPanel>

                <TextBlock Text="About ATCT tool v.1.0 build xxxx"
                           FontSize="16"
                           FontWeight="Bold"
                           Margin="0,0,0,5"/>

                <TextBlock Text="@Copyright 2025-2026 Thermo Fisher Scientific Inc. All rights reserved."
                           FontSize="13"
                           Margin="0,0,0,15"/>

                <TextBlock Text="License information:"
                           FontSize="15"
                           FontWeight="Bold"
                           Margin="0,10,0,5"/>

                <TextBlock Text="License: Commercial Use"
                           FontSize="14"/>

                <TextBlock Text="License Serial Number: 111111"
                           FontSize="14"
                           Margin="0,0,0,15"/>

                <TextBlock Text="Disclaimer and Consent Notice:"
                           FontSize="15"
                           FontWeight="Bold"
                           Margin="0,10,0,10"/>

                <TextBlock Text="Automated Ticketing Creation Tool (ATCT)"
                           FontSize="14"
                           FontWeight="Bold"
                           Margin="0,0,0,5"/>

                <TextBlock Text="“This software tool (“ATCT”) operates as a background service designed to assist with the detection, diagnosis, and resolution of software-related issues. ATCT continuously monitors application audit trails and system-generated error events for the sole purpose of identifying potential defects or operational anomalies."
                           FontSize="13"
                           TextWrapping="Wrap"
                           Margin="0,0,0,10"/>

                <TextBlock Text="Data Collection and Transmission"
                           FontSize="14"
                           FontWeight="Bold"
                           Margin="0,10,0,5"/>

                <TextBlock Text="By installing and enabling ATCT, you acknowledge and agree that:"
                           FontSize="13"
                           Margin="0,0,0,5"/>

                <TextBlock Text="ATCT may automatically collect technical information, including but not limited to application error logs, audit trail entries, stack traces, configuration details, timestamps, and related diagnostic data (“Error Logs”)."
                           FontSize="13"
                           TextWrapping="Wrap"
                           Margin="10,0,0,5"/>

                <TextBlock Text="The collected Error Logs are transmitted automatically via email communication to Thermo Fisher Scientific Support for investigation, troubleshooting, and product improvement purposes."
                           FontSize="13"
                           TextWrapping="Wrap"
                           Margin="10,0,0,5"/>

                <TextBlock Text="The data collected by ATCT is limited to technical and operational information and is not intended to capture personal data unless such data is inherently part of the error context."
                           FontSize="13"
                           TextWrapping="Wrap"
                           Margin="10,0,0,10"/>

                <TextBlock Text="Purpose of Data Use"
                           FontSize="14"
                           FontWeight="Bold"
                           Margin="0,10,0,5"/>

                <TextBlock Text="All Error Logs transmitted by ATCT shall be used exclusively by Thermo Fisher Scientific for:"
                           FontSize="13"
                           Margin="0,0,0,5"/>

                <TextBlock Text="Root cause analysis of software issues"
                           FontSize="13"
                           Margin="10,0,0,2"/>

                <TextBlock Text="Product support and maintenance"
                           FontSize="13"
                           Margin="10,0,0,2"/>

                <TextBlock Text="Quality improvement and defect prevention"
                           FontSize="13"
                           Margin="10,0,0,5"/>

                <TextBlock Text="Thermo Fisher Scientific will not use the collected information for purposes unrelated to software support without prior authorization."
                           FontSize="13"
                           TextWrapping="Wrap"
                           Margin="0,0,0,10"/>

                <TextBlock Text="Confidentiality and Non-Disclosure"
                           FontSize="14"
                           FontWeight="Bold"
                           Margin="0,10,0,5"/>

                <TextBlock Text="By installing or using ATCT, you expressly consent to the disclosure of the collected Error Logs to Thermo Fisher Scientific and agree that such disclosure is governed by the Thermo Fisher Scientific Non-Disclosure and Confidentiality Policy, as outlined in the applicable Non-Disclosure Agreement (NDA) between your organization and Thermo Fisher Scientific."
                           FontSize="13"
                           TextWrapping="Wrap"
                           Margin="0,0,0,5"/>

                <TextBlock Text="You represent that you are authorized to provide such data under the terms of your organization’s NDA and internal policies."
                           FontSize="13"
                           TextWrapping="Wrap"
                           Margin="0,0,0,10"/>

                <TextBlock Text="Responsibility and Compliance"
                           FontSize="14"
                           FontWeight="Bold"
                           Margin="0,10,0,5"/>

                <TextBlock Text="You are responsible for ensuring that:"
                           FontSize="13"
                           Margin="0,0,0,5"/>

                <TextBlock Text="The installation and use of ATCT complies with your organization’s internal policies, regulatory requirements, and data protection obligations."
                           FontSize="13"
                           TextWrapping="Wrap"
                           Margin="10,0,0,5"/>

                <TextBlock Text="Appropriate approvals have been obtained before enabling automated log transmission."
                           FontSize="13"
                           TextWrapping="Wrap"
                           Margin="10,0,0,15"/>

                <TextBlock Text="If you do not agree to these terms, you must not install, enable, or use ATCT.”"
                           FontSize="13"
                           FontWeight="Bold"
                           TextWrapping="Wrap"/>

            </StackPanel>
        </ScrollViewer>
    </Grid>





</Page>
