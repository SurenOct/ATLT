<Page x:Class="CMATCTUI.Pages.AboutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:CMATCTUI.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AboutPage">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0"
                 Text="About ATCT"
                 FontSize="24"
                 FontWeight="Bold"
                 Margin="0 0 0 10" />

        <!-- Content -->
        <StackPanel Grid.Row="1" Margin="0 10 0 0">
            <TextBlock Text="ATCT - Automated Troubleshooting Tool"
                     FontSize="16"
                     FontWeight="SemiBold" />
            <TextBlock Text="Thermo Fisher Scientific"
                     Margin="0 3 0 15" />

            <StackPanel Margin="0 0 0 10">
                <TextBlock Text="Version:" FontWeight="Bold" />
                <TextBlock x:Name="TxtVersion" Text="1.0.0 (demo)" />
            </StackPanel>

            <StackPanel Margin="0 0 0 10">
                <TextBlock Text="Build:" FontWeight="Bold" />
                <TextBlock x:Name="TxtBuild" Text="2025-12-04" />
            </StackPanel>

            <StackPanel Margin="0 0 0 10">
                <TextBlock Text="Description:" FontWeight="Bold" />
                <TextBlock Text="ATCT continuously monitors Chromeleon logs, captures context around errors (sequences, Windows event logs, SSR/folder backups), and supports faster troubleshooting."
                         TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Margin="0 10 0 10">
                <TextBlock Text="Environment:" FontWeight="Bold" />
                <TextBlock x:Name="TxtEnvironment"
                         Text="Demo environment on this machine."
                         TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Margin="0 10 0 0">
                <TextBlock Text="Support:" FontWeight="Bold" />
                <TextBlock Text="For support, contact your Thermo Fisher representative or internal IT support."
                         TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
