<Page x:Class="CMATCTUI.Pages.AuditTrailPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:CMATCTUI.Pages"
      mc:Ignorable="d" 
        xmlns:vm="clr-namespace:CMATCTUI.ViewModels"
        Title="Errors">
    <Page.DataContext>
        <vm:ErrorsViewModel></vm:ErrorsViewModel>
    </Page.DataContext>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Header -->
            <RowDefinition Height="*"/>
            <!-- Grid 1 -->
            <RowDefinition Height="Auto"/>
            <!-- Header 2 -->
            <RowDefinition Height="*"/>
            <!-- Grid 2 -->
        </Grid.RowDefinitions>

        <!-- ================= HEADER + FILTERS ================= -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="Audit Trail"
                       FontSize="24"
                       FontWeight="Bold"/>

            <StackPanel Orientation="Horizontal" Margin="0,10,0,10">
                <TextBlock Text="From Date" VerticalAlignment="Center"/>
                <DatePicker SelectedDate="{Binding FromDate}"
                            Width="150"
                            Margin="10,0,0,0"/>

                <TextBlock Text="To Date"
                           Margin="10,0,0,0"
                           VerticalAlignment="Center"/>
                <DatePicker SelectedDate="{Binding ToDate}"
                            Width="150"
                            Margin="10,0,0,0"/>

                <Button Content="Create Ticket"
                        Width="100"
                        Margin="20,0,0,0"
                        Click="Button_Click"/>
            </StackPanel>
        </StackPanel>

        <!-- ================= FIRST GRID ================= -->
        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding ErrorsView}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True" Height="250px" VerticalScrollBarVisibility="Auto">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Date" Binding="{Binding Date}" />
                <DataGridTextColumn Header="Time" Binding="{Binding Time}" />
                <DataGridTextColumn Header="Retention Time" Binding="{Binding RetentionTime}" />
                <DataGridTextColumn Header="Device" Binding="{Binding Instrument}" />
                <DataGridTextColumn Header="Message" Binding="{Binding Summary}" Width="2*" />
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- ================= SECOND HEADER ================= -->
        <TextBlock Grid.Row="2"
                   Text="Completed Audit Trail"
                   FontSize="20"
                   FontWeight="Bold"
                   Margin="0,10,0,10"/>

        <!-- ================= SECOND GRID ================= -->
        <DataGrid Grid.Row="3"
                  ItemsSource="{Binding AuditCompletedErrors}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True" Height="200" VerticalScrollBarVisibility="Auto">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Date" Binding="{Binding Date}" />
                <DataGridTextColumn Header="Time" Binding="{Binding Time}" />
                <DataGridTextColumn Header="Retention Time" Binding="{Binding RetentionTime}" />
                <DataGridTextColumn Header="Device" Binding="{Binding Instrument}" />
                <DataGridTextColumn Header="Message" Binding="{Binding Summary}" Width="2*" />
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" />
            </DataGrid.Columns>
        </DataGrid>

    </Grid>


</Page>
