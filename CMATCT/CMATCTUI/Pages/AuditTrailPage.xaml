<Page x:Class="CMATCTUI.Pages.AuditTrailPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:CMATCTUI.Pages"
      mc:Ignorable="d" 
        xmlns:vm="clr-namespace:CMATCTUI.ViewModels"
      d:DesignHeight="450" d:DesignWidth="800"
        Title="Errors">
    <Page.DataContext>
        <vm:ErrorsViewModel></vm:ErrorsViewModel>
    </Page.DataContext>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="500"/>
        </Grid.RowDefinitions>

        <!-- Header + Filters (unchanged) -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="Audit Trail"
                   FontSize="24"
                   FontWeight="Bold" />
            <StackPanel Orientation="Horizontal" Margin="0 10 0 10">
                <!--<TextBlock Text="Severity:" VerticalAlignment="Center" Margin="0 0 5 0"/>
                <ComboBox Width="120" Margin="0 0 15 0">
                    <ComboBoxItem Content="All" IsSelected="True" />
                    <ComboBoxItem Content="Critical" />
                    <ComboBoxItem Content="Warning" />
                    <ComboBoxItem Content="Info" />
                </ComboBox>

                <TextBlock Text="Search:" VerticalAlignment="Center" Margin="0 0 5 0"/>
                <TextBox Width="200" Margin="0 0 15 0"
                     ToolTip="Sequence name, message..." />-->

                <TextBlock Text="From Date"></TextBlock>
                <DatePicker SelectedDate="{Binding FromDate}" Width="150" Margin="10,0,0,0"></DatePicker>

                <TextBlock Margin="10,0,0,0" Text="To Date"></TextBlock>
                <DatePicker SelectedDate="{Binding ToDate}" Width="150" Margin="10,0,0,0"></DatePicker>

                
                <Button Content="Create Ticket" Click="Button_Click" Margin="20,0,0,0" Width="80" />
            </StackPanel>
        </StackPanel>

        <!-- Error Table -->
        <DataGrid x:Name="ErrorsDataGrid"   Grid.Row="1"
          ItemsSource="{Binding ErrorsView}"
          AutoGenerateColumns="False"
          IsReadOnly="True"
          SelectionMode="Single">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="*" />
                <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="*" />
                <DataGridTextColumn Header="Retention Time" Binding="{Binding RetentionTime}" Width="*" />
                <DataGridTextColumn Header="Device" Binding="{Binding Instrument}" Width="*" />
                <DataGridTextColumn Header="Message" Binding="{Binding Summary}" Width="2*" />
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>
