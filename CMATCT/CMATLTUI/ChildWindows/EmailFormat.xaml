<Window x:Class="CMATCTUI.ChildWindows.EmailFormat"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CMATCTUI.ChildWindows"
          xmlns:vm="clr-namespace:CMATCTUI.ViewModels"
         xmlns:converters="clr-namespace:CMATCTUI.Converter"
        mc:Ignorable="d"
        Title="EmailFormat" Height="450" Width="800">
    <Window.Resources>
        <converters:BooleanConverterVisiblity x:Key="BoolToVisibilityConverter"/>
        <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
    </Window.Resources>


    <Grid>

        <!-- Main Content -->
        <Grid Margin="20" IsEnabled="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="500"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Text="Email Format"
                       FontSize="24"
                       FontWeight="Bold" />
                <StackPanel Orientation="Vertical" Margin="0 10 0 10">
                    <TextBlock Text="Please Provide Additional Information for request:" FontWeight="Bold" VerticalAlignment="Center" Margin="10 0 5 0"/>
                    <TextBlock  Text="Incident Type:"  VerticalAlignment="Center" Margin="10 20 5 0"/>
                    <ComboBox  Margin="10 20 0 0" Width="400"
                           HorizontalAlignment="Left"
                           ItemsSource="{Binding IncidentsItems}"
                           SelectedItem="{Binding SelectedIncidentType, Mode=TwoWay}" >
                    </ComboBox>

                    <TextBlock Text="Incident Description:" FontWeight="Bold" VerticalAlignment="Center" Margin="10 30 5 0"/>
                    <TextBox Width="500" Margin="10 0 50 0" HorizontalAlignment="Left" Height="50"
                         Text="{Binding IncidentDescription}"
                         ToolTip="Please Provide Brief Description"
                         AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" />

                    <StackPanel Orientation="Horizontal">
                       
                        <TextBlock Text="Attach File:" FontWeight="Bold" VerticalAlignment="Center" Margin="10 0 0 0"/>
                        <TextBlock Text="{Binding StatusMessage}" FontWeight="Bold" VerticalAlignment="Center" Margin="10 0 0 0" Foreground="Red"/>
                        <Button Content="Send Email"  Margin="10 0 0 0" Width="80" Command="{Binding SendEmailCommand}" Height="30" HorizontalAlignment="Right"/>
                    </StackPanel>

                   
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Busy Overlay -->
        <Grid Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"
          Background="#80000000">
            <Border Width="300"
                Padding="20"
                Background="White"
                CornerRadius="6"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <StackPanel HorizontalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Height="20" Width="250" />
                    <TextBlock Text="{Binding ProgressStatus,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" 
                           Margin="0 10 0 0"
                           HorizontalAlignment="Center"
                           FontWeight="SemiBold" />
                </StackPanel>
            </Border>
        </Grid>

    </Grid>

</Window>
